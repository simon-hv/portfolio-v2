{
  "name": "portfolio-v2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && pnpm run build-setup && astro build && pnpm run kill-assets",
    "build-setup": "pnpm run serve-assets & pnpm run wait-for-assets",
    "serve-assets": "serve -p 3001 --no-port-switching ./src/assets",
    "wait-for-assets": "wait-on -t 5000 http://localhost:3001/og/avatar.jpeg",
    "kill-assets": "kill-port 3001 || true",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/red-hat-mono": "^5.2.5",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@rehype-pretty/transformers": "^0.13.2",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "astro": "^5.16.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "postcss-for": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-pretty-code": "^0.14.1",
    "satori": "^0.12.2",
    "sharp": "^0.34.1",
    "shiki": "^3.2.2",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.14.1",
    "install": "^0.13.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "serve": "^14.2.4",
    "shikiji-transformers": "^0.10.2",
    "wait-on": "^8.0.3"
  },
  "packageManager": "pnpm@9.12.3"
}
