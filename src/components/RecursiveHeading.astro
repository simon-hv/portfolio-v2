---
import type { TreeHeading } from "@/lib/headings";

type Props = {
  heading: TreeHeading;
};

const { heading } = Astro.props;
---

<li>
  <a
    href={`#${heading.slug}`}
    class="text-muted-foreground no-underline transition-colors hover:text-foreground"
  >
    {heading.text}
  </a>
  {
    heading.children.length > 0 && (
      <ul class="mt-2 space-y-2 border-l border-border pl-3">
        {heading.children.map((child) => (
          <Astro.self heading={child} />
        ))}
      </ul>
    )
  }
</li>
