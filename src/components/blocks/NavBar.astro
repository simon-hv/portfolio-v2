---
import { emailAddress } from "@/constants";
---

<header
  aria-label="Menu bar"
  class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
  id="topbar"
>
  <div class="mx-auto flex max-w-2xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="flex items-center gap-2 font-medium text-foreground no-underline transition-colors hover:text-muted-foreground"
    >
      <img
        src="/avatar.jpeg"
        alt="Simon Haïoun-Viet"
        class="size-8 rounded-full object-cover"
      />
      <span class="sm:hidden">Simon</span>
      <span class="hidden sm:inline">Simon Haïoun-Viet</span>
    </a>

    <nav aria-label="Main navigation" class="flex items-center gap-6">
      <a
        href="/blog"
        class="text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
        data-umami-event="Blog link"
      >
        Blog
      </a>
      <a
        href="/xp"
        class="text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
      >
        Experience
      </a>
      <a
        href={`mailto:${emailAddress}`}
        class="text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
        data-umami-event="Contact link"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
