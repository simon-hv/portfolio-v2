---
import { humanizeDate } from "@/lib/utils";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<section class="mb-20">
  <h2
    class="mb-8 text-sm font-medium uppercase tracking-wider text-muted-foreground"
  >
    Recent Writing
  </h2>

  <ul class="divide-y divide-border">
    {
      posts.map((post) => (
        <li class="py-4 first:pt-0 last:pb-0">
          <a href={`/blog/${post.id}`} class="group block no-underline">
            <span class="mb-1 block font-medium text-foreground transition-colors group-hover:text-accent">
              {post.data.title}
            </span>
            <span class="text-sm text-muted-foreground">
              {humanizeDate(post.data.date)}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a
    href="/blog"
    class="mt-6 inline-block animate-pulse text-sm no-underline transition-colors"
  >
    View all posts &rarr;
  </a>
</section>
