---
import SectionHeading from "@/components/SectionHeading.astro";
import { getCollection } from "astro:content";
import { ArrowRight, ArrowUpRight } from "lucide-react";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", { year: "numeric", month: "short" });
---

<section
  id="writing"
  class="grid scroll-mt-20 gap-12 border-t border-border py-20 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
>
  <div class="reveal">
    <SectionHeading index="04" label="Writing">
      Notes along<br />the way.
    </SectionHeading>
  </div>

  <div class="flex flex-col items-start gap-8">
    <ul class="w-full">
      {
        posts.map((post, i) => (
          <li class="reveal" style={`--i: ${i}`}>
            <a
              href={`/blog/${post.id}`}
              class="group grid items-baseline gap-x-8 gap-y-2 border-t border-border py-6 text-foreground no-underline hover:text-foreground sm:grid-cols-[13rem_minmax(0,1fr)_auto]"
            >
              <span class="font-mono text-[0.8125rem] text-muted-foreground">
                {formatDate(post.data.date)}
              </span>
              <span class="text-[1.0625rem] font-semibold">
                {post.data.title}
              </span>
              <ArrowUpRight
                className="hidden size-5 self-center text-muted-foreground transition-[transform,color] duration-300 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:block"
                strokeWidth={1.6}
              />
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/blog"
      class="reveal group inline-flex items-center gap-2 text-[0.9375rem] text-muted-foreground no-underline hover:text-foreground"
    >
      See all posts
      <ArrowRight
        className="size-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
        strokeWidth={1.6}
      />
    </a>
  </div>
</section>
