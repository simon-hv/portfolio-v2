---
import SectionHeading from "@/components/SectionHeading.astro";

// Descriptions are trusted static strings and may contain links.
const projects = [
  {
    company: "Crew",
    title: "Semantic candidate search",
    description:
      "Vector search on pgvector embeddings, used daily by all recruiters to source candidates for open positions.",
    stack: "pgvector · PostgreSQL · Fastify",
  },
  {
    company: "Crew",
    title: "Ingestion workflows",
    description:
      "Mastra workflows that extract structured data and keep the CRM enriched and up to date.",
    stack: "Mastra · AI SDK · TypeScript",
  },
  {
    company: "Welcome to the Jungle",
    title: "Homepage & job page redesign",
    description:
      'The two most visited pages of a job board with 2M+ monthly visitors. Also helped maintain <a href="https://welcome-ui.com/" target="_blank" rel="noopener noreferrer">Welcome UI</a>, the company\'s open-source design system.',
    stack: "React · TypeScript · Tailwind",
  },
  {
    company: "Crew",
    title: "AI notetaker",
    description:
      "Joins recruiter calls, writes structured summaries and fills in CRM fields, replacing manual note-taking.",
    stack: "Node.js · AI SDK · Next.js",
  },
  {
    company: "Hawk",
    title: "Ad creative builder",
    description:
      "A React application built from scratch for advertisers to create and manage their ad creatives.",
    stack: "React · TypeScript · Node.js",
  },
];
---

<section
  id="work"
  class="flex scroll-mt-20 flex-col gap-10 border-t border-border py-20 sm:py-24"
>
  <div class="reveal">
    <SectionHeading index="02" label="Selected work">
      What I've built.
    </SectionHeading>
  </div>

  <ul>
    {
      projects.map(({ company, title, description, stack }, i) => (
        <li class="reveal" style={`--i: ${Math.min(i, 3)}`}>
          <div class="group grid items-baseline gap-x-8 gap-y-2 border-t border-border py-7 lg:grid-cols-[10rem_minmax(0,1.1fr)_minmax(0,1.3fr)_14rem]">
            <span class="font-mono text-[0.8125rem] text-muted-foreground">
              {company}
            </span>
            <h3 class="font-display text-[clamp(1.375rem,2.2vw,1.625rem)] font-semibold leading-tight tracking-[-0.02em] transition-transform duration-300 ease-out group-hover:translate-x-1.5">
              {title}
            </h3>
            <p
              class="text-[0.9375rem] leading-normal text-muted-foreground"
              set:html={description}
            />
            <span class="font-mono text-xs text-foreground/80 lg:text-right">
              {stack}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</section>
