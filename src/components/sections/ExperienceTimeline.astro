---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";

const experiences = (await getCollection("experiences"))
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, 4);

const experiencesWithContent = await Promise.all(
  experiences.map(async (exp) => {
    const { Content } = await render(exp);
    return { ...exp, Content };
  }),
);
---

<section>
  <h2
    class="mb-8 text-sm font-medium uppercase tracking-wider text-muted-foreground"
  >
    Experience
  </h2>

  <div class="space-y-8 border-l border-border pl-6">
    {
      experiencesWithContent.map(({ data, Content }) => (
        <div class="relative">
          <div class="absolute left-[calc(-1.5rem-0.5px)] top-4 h-2 w-2 -translate-x-1/2 rounded-full bg-muted-foreground" />

          <div class="flex items-start gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-md bg-secondary">
              <Image
                src={data.companyLogo}
                alt={data.company}
                width={32}
                height={32}
                class="h-8 w-8 object-contain"
              />
            </span>

            <div class="flex-1">
              <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <h3 class="font-medium">{data.company}</h3>
                  {data.title && (
                    <p class="text-sm text-muted-foreground">{data.title}</p>
                  )}
                </div>
                <span class="text-sm text-muted-foreground">
                  {data.duration}
                </span>
              </div>
              <div class="prose prose-sm prose-invert max-w-none text-foreground/90 [&_p]:my-0">
                <Content />
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                {data.stack.map((tech: string) => (
                  <span class="rounded bg-secondary/50 px-2 py-0.5 text-xs text-muted-foreground">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <a
    href="/xp"
    class="mt-6 inline-block text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
  >
    View full history &rarr;
  </a>
</section>
