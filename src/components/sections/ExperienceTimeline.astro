---
import SectionHeading from "@/components/SectionHeading.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowRight, ArrowUpRight, GraduationCap } from "lucide-react";

const experiences = (await getCollection("experiences"))
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, 4);

const rows = [
  ...experiences.map(({ id, data }) => ({
    href: `/xp#${id}`,
    period: data.duration.replace(" - ", " — "),
    title: data.title ?? data.company,
    subtitle: data.company,
    logo: data.companyLogo,
    summary: data.summary,
  })),
  {
    period: "Education",
    href: undefined,
    title: "Engineering degree in Computer Science",
    subtitle: "Polytech Montpellier",
    logo: undefined,
    summary:
      "Computer Science and Management, after a two-year degree in Computer Science at IUT Montpellier.",
  },
];
---

<section
  id="experience"
  class="grid scroll-mt-20 gap-12 border-t border-border py-20 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
>
  <div class="reveal">
    <SectionHeading index="03" label="Experience">
      Ten years<br />of shipping.
    </SectionHeading>
  </div>

  <div class="flex flex-col items-start gap-8">
    <ol class="w-full">
      {
        rows.map(({ href, period, title, subtitle, logo, summary }, i) => (
          <li
            class="reveal grid gap-x-8 gap-y-3 border-t border-border py-6 sm:grid-cols-[13rem_minmax(0,1fr)]"
            style={`--i: ${i}`}
          >
            <span class="font-mono text-[0.8125rem] leading-6 text-muted-foreground">
              {period}
            </span>
            <div class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border bg-secondary">
                {logo ? (
                  <Image
                    src={logo}
                    alt=""
                    width={64}
                    height={64}
                    class="size-7 object-contain"
                  />
                ) : (
                  <GraduationCap
                    className="size-5 text-muted-foreground"
                    strokeWidth={1.6}
                  />
                )}
              </span>
              <div class="flex min-w-0 flex-col gap-1">
                {href ? (
                  <a
                    href={href}
                    class="group inline-flex items-center gap-1.5 self-start text-[1.0625rem] font-semibold leading-6 text-foreground no-underline hover:text-accent"
                  >
                    {title}
                    <ArrowUpRight
                      className="size-4 shrink-0 text-muted-foreground transition-[transform,color] duration-300 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
                      strokeWidth={1.6}
                    />
                  </a>
                ) : (
                  <span class="text-[1.0625rem] font-semibold leading-6">
                    {title}
                  </span>
                )}
                <span class="text-[0.9375rem] text-muted-foreground">
                  {subtitle}
                </span>
              </div>
            </div>
            {summary && (
              <p class="max-w-[36rem] text-[0.9375rem] leading-relaxed text-foreground/80 sm:col-start-2 sm:pl-14">
                {summary}
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <a
      href="/xp"
      class="reveal group inline-flex items-center gap-2 text-[0.9375rem] text-muted-foreground no-underline hover:text-foreground"
    >
      See the full experience
      <ArrowRight
        className="size-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
        strokeWidth={1.6}
      />
    </a>
  </div>
</section>
