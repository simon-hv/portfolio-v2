---
import SectionHeading from "@/components/SectionHeading.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowRight, GraduationCap } from "lucide-react";

const experiences = (await getCollection("experiences"))
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, 4);

const rows = [
  ...experiences.map(({ data }) => ({
    period: data.duration.replace(" - ", " — "),
    title: data.title ?? data.company,
    subtitle: data.company,
    logo: data.companyLogo,
  })),
  {
    period: "Education",
    title: "Polytech Montpellier",
    subtitle:
      "Engineering degree in Computer Science, after a two-year degree at IUT Montpellier",
    logo: undefined,
  },
];
---

<section
  id="experience"
  class="grid scroll-mt-20 gap-12 border-t border-border py-20 sm:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]"
>
  <div class="reveal">
    <SectionHeading index="03" label="Experience">
      Ten years<br />of shipping.
    </SectionHeading>
  </div>

  <div class="flex flex-col items-start gap-8">
    <ol class="w-full">
      {
        rows.map(({ period, title, subtitle, logo }, i) => (
          <li
            class="reveal grid gap-x-8 gap-y-3 border-t border-border py-6 sm:grid-cols-[13rem_minmax(0,1fr)]"
            style={`--i: ${i}`}
          >
            <span class="font-mono text-[0.8125rem] leading-6 text-muted-foreground">
              {period}
            </span>
            <div class="flex items-start gap-4">
              <span class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border bg-secondary">
                {logo ? (
                  <Image
                    src={logo}
                    alt=""
                    width={64}
                    height={64}
                    class="size-7 object-contain"
                  />
                ) : (
                  <GraduationCap
                    className="size-5 text-muted-foreground"
                    strokeWidth={1.6}
                  />
                )}
              </span>
              <div class="flex min-w-0 flex-col gap-1">
                <span class="text-[1.0625rem] font-semibold leading-6">
                  {title}
                </span>
                <span class="text-[0.9375rem] text-muted-foreground">
                  {subtitle}
                </span>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <a
      href="/xp"
      class="reveal group inline-flex items-center gap-2 text-[0.9375rem] text-muted-foreground no-underline hover:text-foreground"
    >
      See the full experience
      <ArrowRight
        className="size-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
        strokeWidth={1.6}
      />
    </a>
  </div>
</section>
