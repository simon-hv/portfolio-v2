---
import { render } from "astro:content";
import TagList from "@/components/blog/TagList.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Layout from "@/layouts/Layout.astro";
import { humanizeDate } from "@/lib/utils";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog");
  return blogPosts.map((post) => {
    const { id } = post;

    return {
      params: { id },
      props: { ...post, ogImage: `/blog/${id}/og.png` },
    };
  });
}

type Props = CollectionEntry<"blog"> & { ogImage: string };

const blogPost: Props = Astro.props;
const { Content, headings } = await render(blogPost);
const { title, description, date, tags } = blogPost.data;

const permalink = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(blogPost.ogImage, Astro.site).href;
---

<Layout description={description} title={`${title} - Simon Haïoun-Viet`}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:url" content={permalink} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={permalink} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageURL} />
  </Fragment>

  <main id="main-content" class="mx-auto max-w-4xl px-6 py-16">
    <article class="lg:grid lg:grid-cols-[1fr_200px] lg:gap-12">
      <div class="prose prose-invert prose-lg max-w-none">
        <header class="not-prose mb-12">
          <a
            href="/blog"
            class="mb-4 inline-block text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
          >
            &larr; Back to blog
          </a>
          <time
            datetime={date.toISOString()}
            class="block text-sm text-muted-foreground"
          >
            {humanizeDate(date)}
          </time>
          <h1 class="mb-4 mt-2 text-4xl font-bold tracking-tighter">
            {title}
          </h1>
          <TagList tags={tags} />
        </header>

        <div class="lg:hidden">
          <TableOfContents headings={headings} />
        </div>

        <Content />
      </div>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </article>
  </main>
</Layout>

<script>
  const SCROLL_OFFSET_PX = 100;
  const BOTTOM_THRESHOLD_PX = 50;
  const ACTIVE_CLASS = "text-foreground";
  const INACTIVE_CLASS = "text-muted-foreground";

  function initScrollSpy() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
      'aside nav a[href^="#"]'
    );
    if (tocLinks.length === 0) return;

    const linksByHeadingId = new Map<string, HTMLAnchorElement>();
    const headings: HTMLElement[] = [];

    for (const link of tocLinks) {
      const id = link.getAttribute("href")?.slice(1);
      if (!id) continue;

      const heading = document.getElementById(id);
      if (!heading) continue;

      linksByHeadingId.set(id, link);
      headings.push(heading);
    }

    if (headings.length === 0) return;

    let currentActiveId: string | null = null;

    const setActiveLink = (id: string) => {
      if (id === currentActiveId) return;

      if (currentActiveId) {
        const prevLink = linksByHeadingId.get(currentActiveId);
        prevLink?.classList.replace(ACTIVE_CLASS, INACTIVE_CLASS);
      }

      const nextLink = linksByHeadingId.get(id);
      nextLink?.classList.replace(INACTIVE_CLASS, ACTIVE_CLASS);
      currentActiveId = id;
    };

    const getActiveHeadingId = (): string => {
      const isAtBottom =
        window.innerHeight + window.scrollY >=
        document.body.scrollHeight - BOTTOM_THRESHOLD_PX;

      if (isAtBottom) {
        return headings[headings.length - 1].id;
      }

      let activeHeading = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= SCROLL_OFFSET_PX) {
          activeHeading = heading;
        } else {
          break;
        }
      }

      return activeHeading.id;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        setActiveLink(getActiveHeadingId());
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    setActiveLink(getActiveHeadingId());

    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true }
    );
  }

  initScrollSpy();
  document.addEventListener("astro:after-swap", initScrollSpy);
</script>
