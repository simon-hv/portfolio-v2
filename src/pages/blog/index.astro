---
import FeaturedPostCard from "@/components/blog/FeaturedPostCard.astro";
import PostList from "@/components/blog/PostList.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPost = allPosts.find((p) => p.data.featured);
const regularPosts = allPosts.filter((p) => !p.data.featured);

const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();
---

<Layout
  description="Articles about web development."
  title="Blog - Simon Haïoun-Viet"
>
  <main class="mx-auto max-w-2xl px-6 py-16">
    <header class="mb-12">
      <h1 class="mb-4 text-3xl font-semibold tracking-tight">Blog</h1>
      Web development, thoughts, and everything in between.
    </header>

    {
      featuredPost && (
        <section class="mb-12">
          <h2 class="mb-6 text-sm font-medium uppercase tracking-wider text-muted-foreground">
            Featured
          </h2>
          <FeaturedPostCard post={featuredPost} />
        </section>
      )
    }

    {
      allTags.length > 0 && (
        <nav class="mb-8 flex flex-wrap gap-2" aria-label="Filter by tag">
          <a
            href="/blog"
            class="rounded bg-accent px-3 py-1 text-sm text-accent-foreground no-underline"
          >
            All
          </a>
          {allTags.map((tag) => (
            <a
              href={`/blog/tag/${tag}`}
              class="rounded bg-secondary/50 px-3 py-1 text-sm text-muted-foreground no-underline transition-colors hover:bg-secondary hover:text-foreground"
            >
              {tag}
            </a>
          ))}
        </nav>
      )
    }

    <section>
      <PostList posts={regularPosts} />
    </section>
  </main>
</Layout>
